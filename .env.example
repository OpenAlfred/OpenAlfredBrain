# Nach .env kopieren und ausfüllen. Die .env wird nicht eingecheckt.
# Schlüssel anlegen: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=
# E-Mail (optional): Gmail-Adresse und App-Passwort (Google-Konto > Sicherheit > App-Passwörter,
# braucht Zwei-Faktor). Ohne beides läuft Alfred ohne Mail.
MAIL_ADRESSE=
MAIL_PASSWORT=

# Spotify (optional): eigene App unter https://developer.spotify.com/dashboard anlegen,
# Redirect-URI http://127.0.0.1:8890/callback eintragen, dann python -m alfred.musik --einrichten.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Codewort (optional): Im Raum sagst du es statt „Ja“, wenn Alfred eine WhatsApp oder Mail abschicken
# oder den Gästemodus beenden soll. Festlegen mit python -m alfred.codewort (fragt verdeckt).
ALFRED_CODEWORT=
